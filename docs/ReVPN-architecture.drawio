<mxfile host="app.diagrams.net" agent="ReVPN" version="24.0.0" type="device">
  <diagram id="revpn-architecture" name="ReVPN Technical Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1275" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= TITLE ================= -->
        <mxCell id="title" value="ReVPN — Technical Architecture" style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1570" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Two interoperable implementations (C++ engine + Python port), three connection modes: server/client (rendezvous), decentralized (STUN + token, no server)" style="text;html=1;fontSize=12;fontStyle=2;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1570" height="24" as="geometry" />
        </mxCell>

        <!-- ================= ENTRY POINTS ================= -->
        <mxCell id="cli" value="ReVPN&#10;(bash CLI + whiptail TUI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="110" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="batwrap" value="ReVPN.bat&#10;(native Windows wrapper)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="190" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pypkg" value="ReVPN-py&#10;(pip package, Python 3, curses TUI)&#10;— pure-Python port, same wire protocol —" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="270" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- ================= ENGINE ================= -->
        <mxCell id="engine" value="ReVPN-engine  (meshvpn.cpp, C++17, single binary)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="110" width="1230" height="330" as="geometry" />
        </mxCell>

        <mxCell id="e2cli" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="cli" target="engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2bat" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="batwrap" target="engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2py" value="same wire&#10;protocol" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="pypkg" target="engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Mode: SERVER -->
        <mxCell id="modeServer" value="--mode server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="150" width="330" height="270" as="geometry" />
        </mxCell>
        <mxCell id="srvWorkers" value="N worker threads&#10;recvmmsg(64) batch recv&#10;+ optional AF_XDP zero-copy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="190" width="290" height="55" as="geometry" />
        </mxCell>
        <mxCell id="srvRelay" value="Relay / rendezvous:&#10;REGISTER → assigns node_id&#10;broadcasts PEER_INFO to all&#10;forwards MSG_DATA if not P2P-direct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="255" width="290" height="65" as="geometry" />
        </mxCell>
        <mxCell id="srvPeer" value="Optional: --vpn-ip&#10;server ALSO joins mesh as a peer&#10;(own TUN, reachable like any client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="330" width="290" height="55" as="geometry" />
        </mxCell>
        <mxCell id="srvSummary" value="No TUN by default — pure bridge/router" style="text;html=1;fontSize=10;fontColor=#666666;align=center;" vertex="1" parent="1">
          <mxGeometry x="450" y="390" width="290" height="20" as="geometry" />
        </mxCell>

        <!-- Mode: CLIENT -->
        <mxCell id="modeClient" value="--mode client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="150" width="330" height="270" as="geometry" />
        </mxCell>
        <mxCell id="cliRegister" value="REGISTER/keepalive → server&#10;receives PEER_INFO for other peers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="190" width="290" height="45" as="geometry" />
        </mxCell>
        <mxCell id="cliPunch" value="P2P: UDP hole punch to each peer&#10;(±8 port prediction for symmetric NAT)&#10;DIRECT once PUNCH_ACK received" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="245" width="290" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cliFallback" value="Silence &gt; T_DROP (3s) → FALLBACK&#10;relay data through server instead&#10;background retry every 30s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="310" width="290" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cliTun" value="TUN device: tun0 (Linux) / Wintun (Windows)&#10;XOR (or libsodium) encrypted MSG_DATA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="375" width="290" height="35" as="geometry" />
        </mxCell>

        <!-- Mode: DECENTRALIZED -->
        <mxCell id="modeDecen" value="--mode decentralized" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1130" y="150" width="480" height="270" as="geometry" />
        </mxCell>
        <mxCell id="dcStun" value="1. STUN Binding Request → learn own&#10;public ip:port (NAT traversal, RFC 5389)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1150" y="190" width="440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="dcToken" value="2. Token = base64(id, ip, port, vpn_ip, node_id)&#10;exchanged BY HAND (chat / voice / email) — no server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1150" y="240" width="440" height="45" as="geometry" />
        </mxCell>
        <mxCell id="dcSeed" value="3. Peer seeded directly into Client.peers[]&#10;— same struct a server's PEER_INFO would fill" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1150" y="295" width="440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="dcReuse" value="4. Reuses Client's own send_vpn / inject_tun /&#10;tick_p2p / on_udp UNCHANGED — same punch,&#10;keepalive and TUN wire format as --mode client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1150" y="345" width="440" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dcNote" value="No relay fallback exists here — if direct punch dies on&#10;both sides, the fix is a fresh token, not a relay hop" style="text;html=1;fontSize=10;fontColor=#8a6d3b;align=center;" vertex="1" parent="1">
          <mxGeometry x="1150" y="400" width="440" height="30" as="geometry" />
        </mxCell>

        <!-- ================= EXTERNAL ENTITIES ================= -->
        <mxCell id="extServer" value="Another ReVPN&#10;--mode server&#10;(rendezvous)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="500" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cli2srv" value="REGISTER / PEER_INFO /&#10;relayed MSG_DATA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;fontSize=10;" edge="1" parent="1" source="modeClient" target="extServer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="extStun" value="Public STUN server&#10;(stun.l.google.com : 19302)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1380" y="500" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dc2stun" value="Binding Request/&#10;Response (UDP)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;fontSize=10;" edge="1" parent="1" source="modeDecen" target="extStun">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="extPeer" value="Peer's ReVPN&#10;--mode decentralized&#10;(different network / NAT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="620" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dc2peerToken" value="Token exchanged by hand&#10;(chat, voice, ...)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;startArrow=open;dashed=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="modeDecen" target="extPeer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1300" y="560" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="dc2peerDirect" value="Direct UDP — hole-punched,&#10;encrypted VPN traffic" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;fontSize=10;strokeColor=#d79b00;exitX=0.7;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="modeDecen" target="extPeer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1440" y="560" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Client to Client P2P direct link -->
        <mxCell id="cli2cli" value="Direct UDP (when punched)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;fontSize=10;strokeColor=#82b366;" edge="1" parent="1" source="modeClient" target="extServer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= WIRE FORMAT ================= -->
        <mxCell id="wire" value="Wire protocol (UDP, shared by every mode/implementation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="460" width="1550" height="140" as="geometry" />
        </mxCell>
        <mxCell id="wireCtrl" value="Control: REGISTER/PEER_INFO (50B) · PUNCH/PUNCH_ACK · KEEPALIVE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="110" y="500" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="wireData" value="Data: DataHdr{type, src_vpn, dst_vpn, payload_len} (11B)&#10;+ payload (+8B nonce if MSG_DATA_ENC, XOR/libsodium)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="610" y="500" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="wireToken" value="Decentralized-only: token = base64(&quot;id,ip,port,vpn_ip,node_id&quot;)&#10;(no wire packet — exchanged out-of-band by the two humans)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="1110" y="500" width="480" height="40" as="geometry" />
        </mxCell>

        <!-- ================= BUILD / PLATFORM ================= -->
        <mxCell id="build" value="Build &amp; platform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="720" width="1550" height="150" as="geometry" />
        </mxCell>
        <mxCell id="buildLinux" value="build.sh → cmake + g++&#10;(engine/CMakeLists.txt)&#10;build/ReVPN-engine&#10;&#10;--xdp   AF_XDP zero-copy (libbpf, clang)&#10;--sodium  real ChaCha20-Poly1305&#10;--native  -march=native" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="760" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="buildWin" value="build_windows.sh → MinGW-w64 cross-compile&#10;build-windows/ReVPN-engine.exe (static)&#10;smoke-tested under Wine&#10;&#10;Wintun.dll required at runtime for --client&#10;and --decentralized TUN device (Administrator)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="760" width="380" height="95" as="geometry" />
        </mxCell>
        <mxCell id="buildPy" value="python/build_windows_exe.sh → PyInstaller&#10;(hosted inside Wine, one-time Python install)&#10;dist/ReVPN.exe — standalone, full TUI baked in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="760" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="buildStress" value="stress_test.sh / tools/stress_client.py&#10;N simulated clients → ring topology (client i → i+1)&#10;UDP flood at the relay server — no root/TUN needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1210" y="760" width="380" height="95" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Legend:  ▭ purple = server mode   ▭ green = client mode   ▭ orange = decentralized mode   ▭ red = external peer/service" style="text;html=1;fontSize=11;fontColor=#666666;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="1230" width="1570" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
