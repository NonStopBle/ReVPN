                <mxCell id="legend" parent="1" style="text;html=1;fontSize=10;align=left;fontStyle=2;fontColor=#666666;" value="&lt;span style=&quot;color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;Solid black line = direct encrypted UDP tunnel — the only real network path that exists in decentralized mode.&lt;br&gt;Dashed boxes = reference information (STUN, optional relay) that is not a live connection in this topology.&lt;/span&gt;" vertex="1">
                    <mxGeometry height="40" width="1030" x="40" y="755" as="geometry"/>
                </mxCell>
                <mxCell id="tAB" edge="1" parent="1" style="edgeStyle=none;html=1;strokeWidth=3;strokeColor=#333333;fontSize=11;fontStyle=1;exitX=1;exitY=0.75;entryX=0;entryY=0.75;startArrow=classic;startFill=1;entryDx=0;entryDy=0;exitDx=0;exitDy=0;" value="&lt;span style=&quot;color: light-dark(rgb(255, 255, 255), rgb(230, 230, 230));&quot;&gt;Direct encrypted UDP tunnel&lt;/span&gt;">
