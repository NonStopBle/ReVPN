                <mxCell id="siteC" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;fontSize=11;fontStyle=1;verticalAlign=top;align=center;dashed=1;" value="&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt;SITE C — a third, separate network&lt;/span&gt;" vertex="1">
