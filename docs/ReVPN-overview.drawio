                <mxCell id="stunnote" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;dashed=1;align=left;spacingLeft=8;" value="Google Public STUN SERVER&lt;br&gt;Each peer queries this once at startup to learn its own&lt;br&gt;public IP:port. Not shown as a connection above." vertex="1">
