                <mxCell id="routerB" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="NO NAT — directly public&lt;br&gt;public IP: &lt;b&gt;198.51.100.17&lt;/b&gt;&lt;br&gt;(learned via STUN at startup)" vertex="1">
