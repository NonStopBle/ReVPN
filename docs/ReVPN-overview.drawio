                    <mxGeometry height="175" width="260" x="40" y="95" as="geometry"/>
                </mxCell>
                <mxCell id="routerA" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="NAT ROUTER&lt;br&gt;public-facing IP: &lt;b&gt;203.0.113.42&lt;/b&gt;&lt;br&gt;(learned via STUN at startup)" vertex="1">
                    <mxGeometry height="60" width="220" x="60" y="122" as="geometry"/>
                </mxCell>
                <mxCell id="hostA" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" value="PEER: alice&#xa;tun0  10.13.0.2 /16" vertex="1">
