                    <mxGeometry height="60" width="220" x="465" y="578" as="geometry"/>
                </mxCell>
                <mxCell id="routerC" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="NAT ROUTER&#xa;public-facing IP: 192.0.2.88&#xa;(learned via STUN at startup)" vertex="1">
